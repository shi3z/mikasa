+// ue4m3 scale byte (sub-block byte index sb of the packed scale word sw) -> half2 {raw, raw}, raw = (byte & 0x7F) << 7 reinterpreted as FP16
+// = ue4m3 value * 2^-8 (normals and subnormals alike); the factor 128 (and the 0.5 of the table) sits in the LUT above, so value*raw is
+// bit-identical to the old value*scale. Needs a finite scale (0x7F, the NaN code, is never produced by the quantiser; checked on the model).
+// sel = pf_sc_sel(sb) is hoisted by the caller.
+PF_DEV uint32_t pf_sc_sel(int sb) { return (uint32_t) sb | (4u << 4) | ((uint32_t) sb << 8) | (4u << 12); }
+PF_DEV uint32_t pf_sc_h2(uint32_t sw, uint32_t sel) { return (__byte_perm(sw, 0u, sel) << 7) & 0x3F803F80u; }
 
